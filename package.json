{
  "name": "ha-plus-plant-care-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ha-plus-frontend-vendor custom_components/plant_care_plus/ha_plus_frontend && esbuild src/plant-care-plus-card.js --bundle --format=iife --target=es2022 --legal-comments=inline --outfile=custom_components/plant_care_plus/frontend/plant-care-plus-card.js",
    "check:build": "npm run build && git diff --exit-code -- custom_components",
    "test": "npm --prefix tests/frontend test"
  },
  "devDependencies": {
    "@ha-plus/ui": "https://github.com/zvikarp/ha-plus-packages/releases/download/ui-v0.3.4/ha-plus-ui-0.3.4.tgz",
    "esbuild": "0.25.12",
    "@ha-plus/frontend": "https://github.com/zvikarp/ha-plus-packages/releases/download/frontend-v0.1.2/ha-plus-frontend-0.1.2.tgz"
  }
}
